-- Logic Execution
local mainGui, keyInput, submitButton, statusLabel, progressFill = createKeySystemUI()
local accessGrantedSignal = Instance.new("BindableEvent")

submitButton.MouseButton1Click:Connect(function()
    local enteredKey = keyInput.Text
    local keyMatches = false

    for _, validKey in ipairs(VALID_KEYS) do
        if enteredKey == validKey then
            keyMatches = true
            break
        end
    end

    if keyMatches then
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        statusLabel.Text = "ACCESS GRANTED! LOADING K13 HUB..."

        submitButton.Active = false
        submitButton.Text = "LOADING..."

        task.spawn(function()
            progressFill.Position = UDim2.new(0, 0, 0, 0)

            for step = 1, 100 do
                if not progressFill.Parent then break end
                progressFill.Size = UDim2.new(step / 100, 0, 1, 0)
                task.wait(0.015)
            end

            task.wait(0.4)
            mainGui:Destroy()
            accessGrantedSignal:Fire()
        end)
    else
        statusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        statusLabel.Text = "ACCESS DENIED! INVALID KEY."

        task.spawn(function()
            for _ = 1, 8 do
                if not submitButton.Parent then break end
                submitButton.Position = UDim2.new(0.04, math.random(-6, 6), 0, 185)
                task.wait(0.04)
            end
            submitButton.Position = UDim2.new(0.04, 0, 0, 185)
        end)

        keyInput.Text = ""
    end
end)

-- Wait for UI access signal before loading payload
accessGrantedSignal.Event:Wait()
loadstring(game:HttpGet(PAYLOAD_URL))()
